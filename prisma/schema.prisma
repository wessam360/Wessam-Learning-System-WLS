// Prisma Schema for Wessam Learning System (WLS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  passwordHash String
  role         String             @default("STUDENT") // ADMIN, TEACHER, STUDENT
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  teacherProfile    TeacherProfile?
  studentProfile    StudentProfile?
  evaluationsGiven  ProjectEvaluation[]
}

model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String?  @default("Computer Science & AI")
  designation String?  @default("Senior Instructor")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignedSubmissions ProjectSubmission[]
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String   @unique
  course    String
  schedule  String
  gender    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectSubmission {
  id            String   @id @default(cuid())
  studentIdCode String   // e.g. WLS-2026-001
  studentName   String
  course        String
  schedule      String   // Mon-Tue, Wed-Thu, Sat-Sun
  gender        String   // Male, Female, Other
  projectName   String
  projectUrl    String
  portfolioUrl  String
  
  teacherId     String
  teacher       TeacherProfile @relation(fields: [teacherId], references: [id])
  
  status        String   @default("PENDING") // PENDING, EVALUATED

  academicRecord AcademicRecord?
  evaluation     ProjectEvaluation?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AcademicRecord {
  id            String            @id @default(cuid())
  submissionId  String            @unique
  submission    ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  participation Float             @default(0) // Max 10
  attendance    Float             @default(0) // Max 10
  quizzes       Float             @default(0) // Max 20
  assignments   Float             @default(0) // Max 20

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ProjectEvaluation {
  id                String            @id @default(cuid())
  submissionId      String            @unique
  submission        ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  synopsisScore     Float             @default(0) // Max 10
  uiUxScore         Float             @default(0) // Max 20
  innovationScore   Float             @default(0) // Max 30
  reportingScore    Float             @default(0) // Max 10
  outcomesScore     Float             @default(0) // Max 10
  groupScore        Float             @default(0) // Max 10
  presentationScore Float             @default(0) // Max 10
  totalScore        Float             @default(0) // Max 100

  feedback          String?
  evaluatorId       String
  evaluator         User              @relation(fields: [evaluatorId], references: [id])

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}
